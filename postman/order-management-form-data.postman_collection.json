    {
      "name": "05 - Create Order - Existing Customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/order-management",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "order-management"
          ]
        },
        "description": "Set customerId and itemSetId before sending. Set real weights/rates or remove optional pricing fields to use label defaults. At least one item is required; up to 200 distinct labels. Does not reserve or reduce stock. Returns 201 and automatically stores the returned ID in the collection orderId variable. Postman sets the multipart Content-Type and boundary automatically. Do not add a manual Content-Type header. Nested keys must remain like items[0][item_set_id] and new_customer[name]. Set price_mode to sale or wholesale. Default is sale for new orders; the selection is saved and returned. Missing selected prices use the other available price.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "customer_id",
              "value": "{{customerId}}",
              "type": "text"
            },
            {
              "key": "order_date",
              "value": "{{orderDate}}",
              "type": "text"
            },
            {
              "key": "remarks",
              "value": "Order from API",
              "type": "text"
            },
            {
              "key": "items[0][item_set_id]",
              "value": "{{itemSetId}}",
              "type": "text"
            },
            {
              "key": "items[0][quantity]",
              "value": "1",
              "type": "text"
            },
            {
              "key": "items[0][gross_weight]",
              "value": "50",
              "type": "text",
              "disabled": true,
              "description": "Optional: check to override; unchecked uses the item label default."
            },
            {
              "key": "items[0][other_weight]",
              "value": "0",
              "type": "text",
              "disabled": true,
              "description": "Optional: check to override; unchecked uses the item label default."
            },
            {
              "key": "items[0][purity]",
              "value": "94",
              "type": "text",
              "disabled": true,
              "description": "Optional: check to override; unchecked uses the item label default."
            },
            {
              "key": "items[0][waste_percent]",
              "value": "0",
              "type": "text",
              "disabled": true,
              "description": "Optional: check to override; unchecked uses the item label default."
            },
            {
              "key": "items[0][metal_rate]",
              "value": "0",
              "type": "text",
              "disabled": true,
              "description": "Optional: check to override; unchecked uses the item label default."
            },
            {
              "key": "items[0][labour_rate]",
              "value": "0",
              "type": "text",
              "disabled": true,
              "description": "Optional: check to override; unchecked uses the item label default."
            },
            {
              "key": "items[0][other_amount]",
              "value": "0",
              "type": "text",
              "disabled": true,
              "description": "Optional: check to override; unchecked uses the item label default."
            },
            {
              "key": "items[0][remarks]",
              "value": "",
              "type": "text",
              "disabled": true,
              "description": "Optional: check to override; unchecked uses the item label default."
            },
            {
              "key": "price_mode",
              "value": "sale",
              "type": "text",
              "description": "sale or wholesale; wholesale requires company setting."
            }
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function stopRequest(message) {",
              "    if (pm.execution && typeof pm.execution.skipRequest === 'function') pm.execution.skipRequest();",
              "    throw new Error(message);",
              "}",
              "const rawBase = String(pm.variables.get('baseUrl') || '').trim();",
              "if (!/^https?:\\/\\//i.test(rawBase) || rawBase.includes('{{')) stopRequest('Set baseUrl in this collection Variables, for example http://127.0.0.1:8000 (without /api).');",
              "pm.variables.set('baseUrl', rawBase.replace(/\\/+$/, ''));",
              "const dateValue = String(pm.variables.get('orderDate') || '').trim();",
              "if (!dateValue || dateValue.includes('{{')) {",
              "    const d = new Date();",
              "    pm.variables.set('orderDate', [d.getFullYear(), String(d.getMonth()+1).padStart(2,'0'), String(d.getDate()).padStart(2,'0')].join('-'));",
              "}",
              "if (pm.request.body && pm.request.body.mode === 'formdata') {",
              "    const fields = pm.request.body.formdata.all().filter(field => !field.disabled);",
              "    function fieldValue(key) { const field = fields.find(field => field.key === key); return field ? pm.variables.replaceIn(String(field.value || '')).trim() : ''; }",
              "    const customer = fieldValue('customer_id');",
              "    if (customer !== 'other' && !/^[1-9]\\d*$/.test(customer)) stopRequest('Set customerId to a numeric customer ID from 01 - Customer and Item Options, or enter the actual ID directly in customer_id.');",
              "    fields.filter(field => /^items\\[\\d+\\]\\[item_set_id\\]$/.test(field.key)).forEach(field => {",
              "        const value = pm.variables.replaceIn(String(field.value || '')).trim();",
              "        if (!/^[1-9]\\d*$/.test(value)) stopRequest('Set itemSetId to the numeric item_set_id from 03 - Scan / Search Items, or enter the actual ID directly in '+field.key+'.');",
              "    });",
              "    if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(fieldValue('order_date'))) stopRequest('order_date must be YYYY-MM-DD, for example 2026-11-25.');",
              "}",
              "const routeValue = String(pm.variables.get('orderId') || '').trim();",
              "if (pm.request.url.toString().includes('{{orderId}}') && !/^[1-9]\\d*$/.test(routeValue)) stopRequest('Set orderId to the numeric ID returned by Create or Order List.');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Successful response', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "if (pm.response.code < 300) { pm.test('API success', function () { pm.expect(pm.response.json().success).to.eql(true); }); }",
              "if (pm.response.code === 201) { pm.collectionVariables.set('orderId', String(pm.response.json().data.id)); }"
            ]
          }
        }
      ],
      "response": []
