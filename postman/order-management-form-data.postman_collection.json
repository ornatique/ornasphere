              "}",
              "const routeValue = String(pm.variables.get('orderId') || '').trim();",
              "if (pm.request.url.toString().includes('{{orderId}}') && !/^[1-9]\\d*$/.test(routeValue)) stopRequest('Set orderId to the numeric ID returned by Create or Order List.');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Successful response', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "if (pm.response.code < 300) { pm.test('API success', function () { pm.expect(pm.response.json().success).to.eql(true); }); }"
            ]
          }
        }
