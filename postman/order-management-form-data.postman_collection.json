  ],
  "event": [],
  "item": [
    {
      "name": "01 - Customer and Item Options",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/order-management/options",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "order-management",
            "options"
          ]
        },
        "description": "Lists this token company's customers and item types. Use active customers for new orders. Copy a customer id into customerId. No login request is included in this collection.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function stopRequest(message) {",
              "    if (pm.execution && typeof pm.execution.skipRequest === 'function') pm.execution.skipRequest();",
              "    throw new Error(message);",
              "}",
              "const rawBase = String(pm.variables.get('baseUrl') || '').trim();",
              "if (!/^https?:\\/\\//i.test(rawBase) || rawBase.includes('{{')) stopRequest('Set baseUrl in this collection Variables, for example http://127.0.0.1:8000 (without /api).');",
              "pm.variables.set('baseUrl', rawBase.replace(/\\/+$/, ''));",
              "const dateValue = String(pm.variables.get('orderDate') || '').trim();",
              "if (!dateValue || dateValue.includes('{{')) {",
              "    const d = new Date();",
              "    pm.variables.set('orderDate', [d.getFullYear(), String(d.getMonth()+1).padStart(2,'0'), String(d.getDate()).padStart(2,'0')].join('-'));",
              "}",
              "if (pm.request.body && pm.request.body.mode === 'formdata') {",
              "    const fields = pm.request.body.formdata.all().filter(field => !field.disabled);",
              "    function fieldValue(key) { const field = fields.find(field => field.key === key); return field ? pm.variables.replaceIn(String(field.value || '')).trim() : ''; }",
              "    const customer = fieldValue('customer_id');",
              "    if (customer !== 'other' && !/^[1-9]\\d*$/.test(customer)) stopRequest('Set customerId to a numeric customer ID from 01 - Customer and Item Options, or enter the actual ID directly in customer_id.');",
              "    fields.filter(field => /^items\\[\\d+\\]\\[item_set_id\\]$/.test(field.key)).forEach(field => {",
              "        const value = pm.variables.replaceIn(String(field.value || '')).trim();",
              "        if (!/^[1-9]\\d*$/.test(value)) stopRequest('Set itemSetId to the numeric item_set_id from 03 - Scan / Search Items, or enter the actual ID directly in '+field.key+'.');",
              "    });",
              "    if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(fieldValue('order_date'))) stopRequest('order_date must be YYYY-MM-DD, for example 2026-11-25.');",
              "}",
              "const routeValue = String(pm.variables.get('orderId') || '').trim();",
              "if (pm.request.url.toString().includes('{{orderId}}') && !/^[1-9]\\d*$/.test(routeValue)) stopRequest('Set orderId to the numeric ID returned by Create or Order List.');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Successful response', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "if (pm.response.code < 300) { pm.test('API success', function () { pm.expect(pm.response.json().success).to.eql(true); }); }"
            ]
          }
        }
      ],
      "response": []
    },
