{
  "info": {
    "name": "Ornasphere - QR Making",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set base_url, token and qr_id. Run requests individually; Delete permanently invalidates the QR. For file uploads select a local logo in Body. All image/download requests require authentication."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://ornasphere.com"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "qr_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "List QR codes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/qr-making?page=1&per_page=10&search="
      }
    },
    {
      "name": "QR details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/qr-making/{{qr_id}}"
      }
    },
    {
      "name": "Create Web QR",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/qr-making",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Ornatique Silver\",\n  \"type\": \"web\",\n  \"size\": 350,\n  \"with_logo\": 0,\n  \"web_url\": \"https://example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Create App QR",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/qr-making",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Ornatique Silver App\",\n  \"type\": \"app\",\n  \"size\": 350,\n  \"with_logo\": 0,\n  \"android_url\": \"https://play.google.com/store/apps/details?id=com.ornatique\",\n  \"ios_url\": \"https://apps.apple.com/app/id6746642350\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Update QR (JSON)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/qr-making/{{qr_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Ornatique Silver\",\n  \"type\": \"web\",\n  \"size\": 350,\n  \"with_logo\": 0,\n  \"web_url\": \"https://example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Preview new QR",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/qr-making/preview",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Ornatique Silver\",\n  \"type\": \"web\",\n  \"size\": 350,\n  \"with_logo\": 0,\n  \"web_url\": \"https://example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Preview existing QR",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/qr-making/preview",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Ornatique Silver\",\n  \"type\": \"web\",\n  \"size\": 350,\n  \"with_logo\": 0,\n  \"web_url\": \"https://example.com\",\n  \"id\": \"{{qr_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Preview image (SVG)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/qr-making/{{qr_id}}/image"
      }
    },
    {
      "name": "Download SVG",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/qr-making/{{qr_id}}/svg"
      }
    },
    {
      "name": "Download PDF",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/qr-making/{{qr_id}}/pdf"
      }
    },
    {
      "name": "Create with logo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/qr-making",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "title",
              "value": "Ornatique Silver",
              "type": "text"
            },
            {
              "key": "type",
              "value": "web",
              "type": "text"
            },
            {
              "key": "size",
              "value": "350",
              "type": "text"
            },
            {
              "key": "with_logo",
              "value": "1",
              "type": "text"
            },
            {
              "key": "web_url",
              "value": "https://example.com",
              "type": "text"
            },
            {
              "key": "logo",
              "type": "file",
              "src": []
            }
          ]
        }
      }
    },
    {
      "name": "Update with logo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/qr-making/{{qr_id}}",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "title",
              "value": "Ornatique Silver",
              "type": "text"
            },
            {
              "key": "type",
              "value": "web",
              "type": "text"
            },
            {
              "key": "size",
              "value": "350",
              "type": "text"
            },
            {
              "key": "with_logo",
              "value": "1",
              "type": "text"
            },
            {
              "key": "web_url",
              "value": "https://example.com",
              "type": "text"
            },
            {
              "key": "logo",
              "type": "file",
              "src": []
            }
          ]
        }
      }
    },
    {
      "name": "Preview with logo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/qr-making/preview",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "title",
              "value": "Ornatique Silver",
              "type": "text"
            },
            {
              "key": "type",
              "value": "web",
              "type": "text"
            },
            {
              "key": "size",
              "value": "350",
              "type": "text"
            },
            {
              "key": "with_logo",
              "value": "1",
              "type": "text"
            },
            {
              "key": "web_url",
              "value": "https://example.com",
              "type": "text"
            },
            {
              "key": "logo",
              "type": "file",
              "src": []
            }
          ]
        }
      }
    },
    {
      "name": "Delete QR (permanent)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/qr-making/{{qr_id}}"
      }
    }
  ]
}
